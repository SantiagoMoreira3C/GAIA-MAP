# GAIA-MAP — .env listo para host gaia0 (puertos libres, sin choques).
# Uso: cp .env.gaia .env
# Luego: docker-compose up -d --build  (o: docker compose up -d --build)
OSIRIS_PORT=3002
CACHE_PORT=8081
RTSP_PORT=8556
HLS_PORT=8891
WEBRTC_PORT=8892
MTX_API_PORT=9998
INTEL_PORT=4000
OSIRIS_AUTO_ORBIT=1
